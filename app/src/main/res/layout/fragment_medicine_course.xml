<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.intakes.MedCourseFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:visibility="visible"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_marginEnd="40sp"
            android:layout_marginStart="40sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolBarImageButton"
                android:src="@drawable/arrow_left_circle"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"/>



            <TextView
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:id="@+id/toolbar_title"
                android:layout_width="200sp"
                android:gravity="center"
                android:layout_height="40sp"
                android:text="Курс приёмов"
                android:lineSpacingMultiplier="0.8"
                android:textColor="@color/purple_500"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginEnd="10sp"/>

            <ImageButton
                android:id="@+id/btn_options"
                style="@style/ToolBarImageButton"
                android:layout_alignParentEnd="true"
                android:contentDescription="options"
                android:src="@drawable/three_dots_oneline" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
    <LinearLayout
        android:layout_alignParentTop="true"
        android:layout_gravity="center"
        android:id="@+id/options_menu"
        android:layout_width="match_parent"
        android:layout_marginEnd="40sp"
        android:layout_marginStart="40sp"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_bg"
        android:elevation="10dp"
        android:layout_marginTop="10sp"
        android:orientation="vertical"
        android:padding="12sp"
        android:paddingStart="20sp"
        android:visibility="gone"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Отчёт PDF"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2sp"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Редактировать"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Завершить"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2sp"
            android:textColor="#D32F2F"
            android:textSize="24sp"
            android:text="Удалить"
            android:fontFamily="@font/nunito_extrabold"
            />
    </LinearLayout>


        <ScrollView
            android:layout_alignParentTop="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20sp"
            android:layout_marginEnd="20sp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100sp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Лекарство"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10sp"
                            android:weightSum="10">

                            <TextView
                                android:layout_weight="9"
                                android:layout_width="0sp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:lineSpacingMultiplier="0.6"
                                android:text="Аскорбинка витаминка полезная с витаминами  А и С"/>



                        </LinearLayout>

                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Дата начала"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/purple_500"
                            android:textSize="28sp"
                            android:lineSpacingMultiplier="0.6"
                            android:text="2 ноября 2025"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Употребление"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:lineSpacingMultiplier="0.6"
                                android:text="до время еды"/>



                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="График"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:lineSpacingMultiplier="0.6"
                                android:text="раз в 3 дня"/>


                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Время и дозировка"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp"
                        android:layout_marginBottom="20sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="10sp"
                                android:weightSum="10">
                                <TextView
                                    android:layout_weight="4"
                                    android:layout_width="0sp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extrabold"
                                    android:textColor="@color/purple_500"
                                    android:textSize="28sp"
                                    android:gravity="start"
                                    android:lineSpacingMultiplier="0.6"
                                    android:text="10:00"/>

                                <TextView
                                    android:layout_weight="4"
                                    android:layout_width="0sp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extrabold"
                                    android:textColor="@color/purple_500"
                                    android:textSize="28sp"
                                    android:gravity="end"
                                    android:lineSpacingMultiplier="0.6"
                                    android:text="1"/>

                                <TextView
                                    android:layout_weight="2"
                                    android:layout_width="0sp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extrabold"
                                    android:textColor="@color/purple_500"
                                    android:textSize="28sp"
                                    android:gravity="end"
                                    android:lineSpacingMultiplier="0.6"
                                    android:text="шт"/>

                            </LinearLayout>

                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>


        </LinearLayout>

    </ScrollView>
    </RelativeLayout>

</LinearLayout>
