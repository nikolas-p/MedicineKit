<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.intakes.CreateIntakeFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:visibility="visible"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="40sp"
            android:layout_marginEnd="40sp">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolBarImageButton"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"
                android:src="@drawable/arrow_left_circle" />


            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="200sp"
                android:layout_height="40sp"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginEnd="10sp"
                android:gravity="center"
                android:lineSpacingMultiplier="0.8"
                android:text="30 сентября воскесенье"
                android:textColor="@color/purple_500"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40sp"
            android:layout_marginTop="40sp"
            android:layout_marginEnd="40sp"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:lineSpacingMultiplier="0.6"
            android:text="Аскорбинка витаминка полезная с витаминами  А и С"
            android:textColor="@color/purple_500"

            android:textSize="28sp" />


        <FrameLayout
            android:layout_width="100sp"
            android:layout_height="100sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20sp"
            android:layout_marginBottom="20sp"
            android:background="@drawable/rounded_white_bg"
            android:elevation="16dp">

            <ImageView
                android:id="@+id/medicine_icon"
                android:layout_width="90sp"
                android:layout_height="90sp"
                android:layout_gravity="center"
                android:contentDescription="картинка спрей"
                android:src="@drawable/spray" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/options_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="40sp"
            android:layout_marginTop="10sp"
            android:layout_marginEnd="40sp"
            android:layout_marginBottom="30sp"
            android:background="@drawable/rounded_white_bg"
            android:elevation="16dp"
            android:orientation="vertical"
            android:padding="10sp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/nunito_extrabold"
                    android:lineSpacingMultiplier="0.6"
                    android:text="1 таблетка, в 10:00"
                    android:textColor="@color/purple_500"
                    android:textSize="24sp" />


                <ImageButton

                    style="@style/ToolBarImageButton"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="add_medication"
                    android:src="@drawable/chevron_right" />


            </RelativeLayout>

            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/nunito_extrabold"
                    android:lineSpacingMultiplier="0.6"
                    android:text="Приняли Вы"
                    android:textColor="@color/purple_500"
                    android:textSize="24sp" />


                <ImageButton

                    style="@style/ToolBarImageButton"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="add_medication"
                    android:src="@drawable/chevron_right" />


            </RelativeLayout>

            <com.google.android.material.button.MaterialButton
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/nunito_extrabold"
                android:text="Принято"
                android:textSize="24sp"

                />

            <com.google.android.material.button.MaterialButton
                style="@style/OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/nunito_bold"
                android:text="не принято"
                android:textSize="24sp"

                />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="100sp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/radial_gradient"
        android:elevation="16dp"
        android:paddingStart="40sp"
        android:paddingEnd="40sp"
        android:visibility="visible"
        app:itemGravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <com.google.android.material.button.MaterialButton
            android:fontFamily="@font/nunito_extrabold"
            android:id="@+id/btn_create"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="60sp"
            android:layout_gravity="center"
            android:layout_margin="1sp"
            android:elevation="26dp"
            android:text="Внести"
            android:textSize="26sp" />
    </com.google.android.material.bottomnavigation.BottomNavigationView>
</LinearLayout>