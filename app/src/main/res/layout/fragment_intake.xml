<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.medications.intakes.IntakeFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:visibility="visible"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_marginEnd="40sp"
            android:layout_marginStart="40sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolBarImageButton"
                android:src="@drawable/arrow_left_circle"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"/>


            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="200sp"
                android:layout_height="40sp"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginEnd="10sp"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:lineSpacingMultiplier="0.8"
                android:text="Подробнее"
                android:textColor="@color/purple_500"
                android:textSize="20sp"
                />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout

        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_marginEnd="40sp"
        android:layout_marginStart="40sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:orientation="vertical"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extrabold"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_marginStart="10sp"
            android:lineSpacingMultiplier="0.6"
            android:text="Не принято"
            android:textColor="#D32F2F"
            />

        <FrameLayout
            android:id="@+id/nevigate_to_medicine_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_gray_border"
            android:padding="10sp"
            android:layout_marginBottom="14sp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <FrameLayout
                    android:layout_width="100sp"
                    android:layout_height="100sp"
                    android:background="@drawable/rounded_gray_border"
                    android:layout_gravity="center_horizontal"
                    android:elevation="1dp"

                    >

                    <ImageView
                        android:layout_width="90sp"
                        android:layout_height="90sp"
                        android:layout_gravity="center"
                        android:src="@drawable/spray"
                        android:contentDescription="картинка спрей"
                        />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_extrabold"
                    android:textSize="24sp"
                    android:layout_marginStart="10sp"
                    android:lineSpacingMultiplier="0.6"
                    android:text="Аскорбинка витаминка полезная с витамином С"
                    />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/intake_item">

            <!-- Текст слева -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Дозировка"
                android:textSize="20sp"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="start" />

            <!-- Текст справа -->
            <TextView
                android:fontFamily="@font/nunito_black"
                android:textColor="@color/purple_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 шт."
                android:textSize="20sp"

                android:gravity="end" />



        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Текст слева -->
            <TextView
                android:fontFamily="@font/nunito_extrabold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Время"
                android:textSize="20sp"
                android:gravity="start" />

            <!-- Текст справа -->
            <TextView
                android:fontFamily="@font/nunito_black"
                android:textColor="@color/purple_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 нояб., 20:20"
                android:textSize="20sp"

                android:gravity="end" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
       >

            <!-- Текст слева -->
            <TextView
                android:fontFamily="@font/nunito_bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Записано в приложение"
                android:textSize="20sp"
                android:lineSpacingMultiplier="0.6"
                android:gravity="start" />

            <!-- Текст справа -->
            <TextView
                android:fontFamily="@font/nunito_bold"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 нояб., 10:10:10"
                android:textSize="20sp"
                android:gravity="end" />



        </LinearLayout>



    </LinearLayout>


</LinearLayout>