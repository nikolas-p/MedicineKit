<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.medications.MedicationFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:visibility="visible"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_marginEnd="40sp"
            android:layout_marginStart="40sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolBarImageButton"
                android:src="@drawable/arrow_left_circle"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"/>


            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="200sp"
                android:layout_height="40sp"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginEnd="10sp"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:lineSpacingMultiplier="0.8"
                android:text="Сведения"
                android:textColor="@color/purple_500"
                android:textSize="20sp"
                />

            <ImageButton
                android:id="@+id/btn_options"
                style="@style/ToolBarImageButton"
                android:layout_alignParentEnd="true"
                android:contentDescription="options"
                android:src="@drawable/three_dots_oneline" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <LinearLayout
        android:layout_alignParentTop="true"
        android:layout_gravity="center"
        android:id="@+id/options_menu"
        android:layout_width="match_parent"
        android:layout_marginEnd="40sp"
        android:layout_marginStart="40sp"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_bg"
        android:elevation="10dp"
        android:layout_marginTop="10sp"
        android:orientation="vertical"
        android:padding="12sp"
        android:paddingStart="20sp"
        android:visibility="gone"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Курсы приёмов"
            android:fontFamily="@font/nunito_extrabold"
            />

        <TextView
            android:id="@+id/nav_intake_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Журнал приёмов"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Отчёт PDF"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2sp"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Редактировать"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="В Архив"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2sp"
            android:textColor="#D32F2F"
            android:textSize="24sp"
            android:text="Удалить"
            android:fontFamily="@font/nunito_extrabold"
            />
    </LinearLayout>






    <ScrollView
        android:layout_alignParentTop="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100sp">

            <FrameLayout
                android:layout_width="100sp"
                android:layout_height="100sp"
                android:background="@drawable/rounded_white_bg"
                android:layout_gravity="center_horizontal"
                android:elevation="16dp"
                android:layout_marginBottom="20sp"
                android:layout_marginTop="20sp"
                >

                <ImageView
                    android:id="@+id/medicine_icon"
                    android:layout_width="90sp"
                    android:layout_height="90sp"
                    android:layout_gravity="center"
                    android:src="@drawable/spray"
                    android:contentDescription="картинка спрей"
                    />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editmedia"
                style="@style/OutlineButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Посмотреть фото"
                android:layout_marginBottom="20sp"
                />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Лекарство"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/purple_500"
                            android:textSize="28sp"
                            android:lineSpacingMultiplier="0.6"

                            android:text="Аскорбинка витаминка полезная с витаминами  А и С"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Лекарственная форма"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/purple_500"
                            android:textSize="28sp"
                            android:lineSpacingMultiplier="0.6"
                            android:text="Таблетка"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Дозировка и единицы"
                        />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5sp"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/purple_500"
                            android:textSize="28sp"
                            android:lineSpacingMultiplier="0.6"
                            android:gravity="center"
                            android:text="10"/>

                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5sp"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/purple_500"
                            android:textSize="28sp"
                            android:lineSpacingMultiplier="0.6"
                            android:gravity="center"
                            android:text="мг"/>

                    </FrameLayout>

                </LinearLayout>
                </LinearLayout>


            </FrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Категория"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/purple_500"
                            android:textSize="28sp"
                            android:lineSpacingMultiplier="0.6"
                            android:text="Витамины и БАДы"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>


</RelativeLayout>





</LinearLayout>