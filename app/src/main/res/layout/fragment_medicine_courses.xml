<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.intakes.MedicineCoursesFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:visibility="visible"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_marginEnd="40sp"
            android:layout_marginStart="40sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolBarImageButton"
                android:src="@drawable/arrow_left_circle"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"/>

            <LinearLayout
                android:layout_width="200sp"
                android:layout_height="40sp"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:height="16sp"
                    android:text="крурсы отсортированы по:"
                    android:textColor="#000" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:text="Дтате"
                        android:textColor="@color/purple_500"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10sp"/>

                    <ImageView
                        app:tint="@color/purple_500"
                        android:layout_width="16sp"
                        android:layout_height="16sp"
                        android:src="@drawable/triangle_pointing_upwards"/>
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_options"
                style="@style/ToolBarImageButton"
                android:layout_alignParentEnd="true"
                android:contentDescription="options"
                android:src="@drawable/filter_circle" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
    <LinearLayout
        android:layout_alignParentTop="true"
        android:layout_gravity="center"
        android:id="@+id/options_menu"
        android:layout_width="match_parent"
        android:layout_marginEnd="40sp"
        android:layout_marginStart="40sp"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_bg"
        android:elevation="10dp"
        android:layout_marginTop="10sp"
        android:orientation="vertical"
        android:padding="12sp"
        android:paddingStart="20sp"
        android:visibility="gone"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Даты проведения"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2sp"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Получатели"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Название препарата"
            android:fontFamily="@font/nunito_extrabold"
            />


        </LinearLayout>


    <ScrollView
        android:layout_alignParentTop="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp"
        >


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
>

            <FrameLayout
                android:id="@+id/med_course_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3"
                        android:padding="3sp"
                        android:columnOrderPreserved="false">

                        <!-- Row 1 -->
                        <!-- Ячейка 1.1: Фрагмент -->
                        <FrameLayout
                            android:id="@+id/fragmentContainer"
                            android:layout_row="0"
                            android:layout_column="0"
                            android:layout_columnWeight="1"
                            android:layout_width="100sp"
                            android:layout_height="100sp"
                            android:background="@drawable/rounded_gray_border"
                            android:layout_gravity="center"


                            >

                            <ImageView
                                android:layout_width="90sp"
                                android:layout_height="90sp"
                                android:layout_gravity="center"
                                android:src="@drawable/spray"
                                android:contentDescription="картинка спрей"
                                />
                        </FrameLayout>

                        <!-- Ячейка 1.2: Текст -->
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_row="0"
                            android:layout_column="1"
                            android:layout_columnWeight="3"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/purple_500"
                            android:textSize="28sp"
                            android:lineSpacingMultiplier="0.6"
                            android:text="Аскорбинка витаминка полезная с витаминами  А и С"
                            android:lines="4"
                            android:ellipsize="end"
                             />

                        <!-- Row 2 -->
                        <TextView
                            android:visibility="gone"
                            android:paddingStart="10sp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_row="1"
                            android:layout_column="0"
                            android:layout_columnWeight="1"
                            android:text="Кому:"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textSize="18sp"
                       />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_row="1"
                            android:layout_column="1"
                            android:layout_columnWeight="3"
                            android:layout_gravity="start"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="для Вас"
                            android:visibility="gone"
                            android:textSize="18sp" />

                        <!-- Row 3 -->
                        <TextView
                            android:paddingStart="10sp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_row="2"
                            android:layout_column="0"
                            android:layout_columnWeight="1"
                            android:text="Даты"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textSize="18sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_row="2"
                            android:layout_column="1"
                            android:layout_columnWeight="3"
                            android:text="с 10.10.2025 по 10.02.2026"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textSize="18sp"
                            android:layout_gravity="start" />

                    </GridLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10sp"
                        android:layout_gravity="center"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="Интервал приёма раз в 3дня"
                        android:textColor="@color/purple_500"
                        android:textSize="18sp" />


                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

    </ScrollView>
    </RelativeLayout>








</LinearLayout>