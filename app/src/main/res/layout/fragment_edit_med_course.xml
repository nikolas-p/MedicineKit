<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.intakes.EditMedCourseFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:visibility="visible"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_marginEnd="40sp"
            android:layout_marginStart="40sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolBarImageButton"
                android:src="@drawable/arrow_left_circle"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"/>



            <TextView
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:id="@+id/toolbar_title"
                android:layout_width="200sp"
                android:gravity="center"
                android:layout_height="40sp"
                android:text="Добавление курса"
                android:lineSpacingMultiplier="0.8"
                android:textColor="@color/purple_500"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginEnd="10sp"/>

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>




    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Лекарство"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10sp"
                            android:weightSum="10">

                        <TextView
                            android:layout_weight="9"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/purple_500"
                            android:textSize="28sp"
                            android:lineSpacingMultiplier="0.6"
                            android:text="Аскорбинка витаминка полезная с витаминами  А и С"/>


                            <ImageButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:src="@drawable/chevron_right"
                                style="@style/ToolBarImageButton"/>

                        </LinearLayout>

                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Дата начала"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                            <TextView
                                android:layout_weight="9"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:lineSpacingMultiplier="0.6"
                                android:text="2 ноября 2025"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Употребление"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10sp"
                            android:weightSum="10">

                            <TextView
                                android:layout_weight="9"
                                android:layout_width="0sp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:lineSpacingMultiplier="0.6"
                                android:text="до время еды"/>


                            <ImageButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:src="@drawable/chevron_right"
                                style="@style/ToolBarImageButton"/>

                        </LinearLayout>

                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="График"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10sp"
                            android:weightSum="10">

                            <TextView
                                android:layout_weight="9"
                                android:layout_width="0sp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:lineSpacingMultiplier="0.6"
                                android:text="раз в 3 дня"/>


                            <ImageButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:src="@drawable/chevron_right"
                                style="@style/ToolBarImageButton"/>

                        </LinearLayout>

                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gray_border"
                android:padding="10sp"
                android:layout_marginBottom="14sp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="20sp"
                        android:layout_marginStart="10sp"
                        android:text="Время и дозировка"
                        />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_gray_border"
                        android:padding="10sp"
                        android:layout_marginBottom="20sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10sp"
                            android:weightSum="10">


                            <ImageButton
                                android:id="@+id/trash"
                                style="@style/ToolBarImageButton"
                                android:src="@drawable/trash"
                                app:tint="#D32F2F"
                                android:layout_alignParentStart="true"
                                android:contentDescription="add_medication"/>

                            <TextView
                                android:layout_weight="4"
                                android:layout_width="0sp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:gravity="end"
                                android:lineSpacingMultiplier="0.6"
                                android:text="10:00"/>

                            <TextView
                                android:layout_weight="4"
                                android:layout_width="0sp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:gravity="end"
                                android:lineSpacingMultiplier="0.6"
                                android:text="1"/>

                            <TextView
                                android:layout_weight="2"
                                android:layout_width="0sp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/purple_500"
                                android:textSize="28sp"
                                android:gravity="end"
                                android:lineSpacingMultiplier="0.6"
                                android:text="шт"/>

                        </LinearLayout>

                        </LinearLayout>
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_time"

                        style="@style/AppButton"
                        android:elevation="26dp"
                        android:layout_width="match_parent"
                        android:layout_height="60sp"
                        android:layout_gravity="center"
                        android:layout_margin="1sp"
                        android:textSize="26sp"
                        android:text="Добавить" />
                </LinearLayout>
            </FrameLayout>




        </LinearLayout>

    </ScrollView>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="100sp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/radial_gradient"
        android:elevation="16dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:itemGravity="center"
        android:paddingEnd="40sp"
        android:paddingStart="40sp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create"
            style="@style/AppButton"
            android:elevation="26dp"
            android:layout_width="match_parent"
            android:layout_height="60sp"
            android:layout_gravity="center"
            android:layout_margin="1sp"
            android:textSize="26sp"
            android:text="Добавить" />
    </com.google.android.material.bottomnavigation.BottomNavigationView>










</LinearLayout>