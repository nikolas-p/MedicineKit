<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ui.medications.QuickMedicationsFragment">

    <!-- Добавляем Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:visibility="visible"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_marginEnd="40sp"
            android:layout_marginStart="40sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolBarImageButton"
                android:src="@drawable/arrow_left_circle"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"/>



            <TextView
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:id="@+id/toolbar_title"
                android:layout_width="200sp"
                android:gravity="center"
                android:layout_height="40sp"
                android:text="Быстрая вставка"
                android:lineSpacingMultiplier="0.8"
                android:textColor="@color/purple_500"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginEnd="10sp"/>




            <ImageButton
                android:id="@+id/btn_search"
                style="@style/ToolBarImageButton"
                android:layout_alignParentEnd="true"
                android:contentDescription="options"
                android:src="@drawable/search" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>


    <!-- Остальная часть контента -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp">

        <RadioGroup
            android:id="@+id/radios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/selection"
            >

            <RadioButton
                android:id="@+id/a"
               style="@style/radioButton"
                android:button="@null"
                android:text="Аскорбинка витаминка полезная c витамином C и А"
           />

            <RadioButton
                android:id="@+id/b"
                style="@style/radioButton"
                android:button="@null"
                android:text="Аскорбинка витаминка полезная c витамином C и А"
                />

            <RadioButton
                android:id="@+id/c"
                style="@style/radioButton"
                android:button="@null"
                android:text="Аскорбинка витаминка c витамином C и А для детей и взрослых"
                />

        </RadioGroup>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="100sp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/radial_gradient"
        android:elevation="16dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:itemGravity="center"
        android:paddingEnd="40sp"
        android:paddingStart="40sp">

        <com.google.android.material.button.MaterialButton
            android:fontFamily="@font/nunito_extrabold"
            android:id="@+id/btn_create"
            style="@style/AppButton"
            android:elevation="26dp"
            android:layout_width="match_parent"
            android:layout_height="60sp"
            android:layout_gravity="center"
            android:layout_margin="1sp"
            android:textSize="26sp"
            android:text="Применить" />
    </com.google.android.material.bottomnavigation.BottomNavigationView>

</LinearLayout>
