<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.medications.editmedication.EditMediaFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:visibility="visible"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_marginEnd="40sp"
            android:layout_marginStart="40sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolBarImageButton"
                android:src="@drawable/arrow_left_circle"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"/>


            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="200sp"
                android:layout_height="40sp"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginEnd="10sp"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:lineSpacingMultiplier="0.8"
                android:text="Медиа данные"
                android:textColor="@color/purple_500"
                android:textSize="20sp"
                />

          </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:text="Упаковка"
                />
            <com.google.android.flexbox.FlexboxLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:alignItems="center"
                app:alignContent="center"
                app:justifyContent="flex_start"

                android:elevation="0dp"
                >

                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/rounded_white_bg"
                    android:layout_gravity="center_horizontal"
                    android:elevation="1dp"
                    android:layout_margin="10dp">

                    <ImageView

                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="#D32F2F"
                        android:src="@drawable/x_circle_fill"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:translationX="0dp"
                        android:translationY="0dp"
                        android:elevation="2dp" />

                </RelativeLayout>


                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/rounded_white_bg"
                    android:layout_gravity="center_horizontal"
                    android:elevation="1dp"
                    android:layout_margin="10dp">

                    <ImageView

                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="#D32F2F"
                        android:src="@drawable/x_circle_fill"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:translationX="0dp"
                        android:translationY="0dp"
                        android:elevation="2dp" />

                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/rounded_white_bg"
                    android:layout_gravity="center_horizontal"
                    android:elevation="1dp"
                    android:layout_margin="10dp">

                    <ImageView

                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="#D32F2F"
                        android:src="@drawable/x_circle_fill"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:translationX="0dp"
                        android:translationY="0dp"
                        android:elevation="2dp" />

                </RelativeLayout>

                <ImageButton
                    android:layout_width="80sp"
                    android:layout_height="80sp"
                    android:layout_margin="10sp"

                    style="@style/ToolBarImageButton"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="options"

                    android:src="@drawable/plus_circle" />

            </com.google.android.flexbox.FlexboxLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:text="Инструкция"
                />
            <com.google.android.flexbox.FlexboxLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:alignItems="center"
                app:alignContent="center"
                app:justifyContent="flex_start"
                android:elevation="0dp"
                >
                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/rounded_white_bg"
                    android:layout_gravity="center_horizontal"
                    android:elevation="1dp"
                    android:layout_margin="10dp">

                    <ImageView

                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="#D32F2F"
                        android:src="@drawable/x_circle_fill"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:translationX="0dp"
                        android:translationY="0dp"
                        android:elevation="2dp" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/rounded_white_bg"
                    android:layout_gravity="center_horizontal"
                    android:elevation="1dp"
                    android:layout_margin="10dp">

                    <ImageView

                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="#D32F2F"
                        android:src="@drawable/x_circle_fill"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:translationX="0dp"
                        android:translationY="0dp"
                        android:elevation="2dp" />

                </RelativeLayout>



                <ImageButton
                    android:layout_width="80sp"
                    android:layout_height="80sp"
                    android:layout_margin="10sp"

                    style="@style/ToolBarImageButton"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="options"

                    android:src="@drawable/plus_circle" />

            </com.google.android.flexbox.FlexboxLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:text="Рецепт"
                />
            <com.google.android.flexbox.FlexboxLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:alignItems="center"
                app:alignContent="center"
                app:justifyContent="flex_start"
                android:elevation="0dp"
                >
                <ImageButton
                    android:layout_width="80sp"
                    android:layout_height="80sp"
                    android:layout_margin="10sp"

                    style="@style/ToolBarImageButton"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="options"

                    android:src="@drawable/plus_circle" />
            </com.google.android.flexbox.FlexboxLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>