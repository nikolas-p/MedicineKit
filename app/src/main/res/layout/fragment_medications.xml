<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.medications.MedicationsFragment">

    <!-- Ваш существующий Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:visibility="visible"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_marginEnd="40sp"
            android:layout_marginStart="40sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_add"
                style="@style/ToolBarImageButton"
                android:src="@drawable/plus_circle"
                android:layout_alignParentStart="true"
                android:contentDescription="add_medication"/>

            <LinearLayout
                android:layout_width="200sp"
                android:layout_height="40sp"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:height="16sp"
                    android:text="отсортировано по:"
                    android:textColor="#000" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:text="Название"
                        android:textColor="@color/purple_500"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10sp"/>

                    <ImageView
                        app:tint="@color/purple_500"
                        android:layout_width="16sp"
                        android:layout_height="16sp"
                        android:src="@drawable/triangle_pointing_upwards"/>
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_options"
                style="@style/ToolBarImageButton"
                android:layout_alignParentEnd="true"
                android:contentDescription="options"
                android:src="@drawable/filter_circle" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>


    <!-- Опциональное меню -->

    <LinearLayout
        android:layout_alignParentTop="true"
        android:layout_gravity="center"
        android:id="@+id/options_menu"
        android:layout_width="match_parent"
        android:layout_marginEnd="40sp"
        android:layout_marginStart="40sp"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_bg"
        android:elevation="10dp"
        android:layout_marginTop="10sp"
        android:orientation="vertical"
        android:padding="12sp"
        android:paddingStart="20sp"
        android:visibility="gone"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Название"
            android:fontFamily="@font/nunito_extrabold"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Срок годности"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Категория"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2sp"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Количество"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2sp"
            android:textSize="24sp"
            android:text="Архив"
            android:fontFamily="@font/nunito_extrabold"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2sp"
            android:textSize="24sp"
            android:text="Правка"
            android:fontFamily="@font/nunito_extrabold"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40sp"
        android:layout_marginEnd="40sp"
        android:orientation="vertical">

        <TextView

            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:text="А"
            android:textColor="@color/purple_500"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginEnd="10sp"/>

        <FrameLayout
            android:id="@+id/nevigate_to_medicine_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_gray_border"
            android:padding="10sp"
            android:layout_marginBottom="14sp"
            >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <FrameLayout
                android:layout_width="100sp"
                android:layout_height="100sp"
                android:background="@drawable/rounded_gray_border"
                android:layout_gravity="center_horizontal"
                android:elevation="1dp"

                >

                <ImageView
                    android:layout_width="90sp"
                    android:layout_height="90sp"
                    android:layout_gravity="center"
                    android:src="@drawable/spray"
                    android:contentDescription="картинка спрей"
                    />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:textSize="24sp"
                android:layout_marginStart="10sp"
                android:lineSpacingMultiplier="0.6"
                android:lines="4"
                android:ellipsize="end"
                android:text="Аскорбинка витаминка полезная с витаминами  А и С"
                />
        </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_gray_border"
            android:padding="10sp"
            android:layout_marginBottom="14sp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <FrameLayout
                    android:layout_width="100sp"
                    android:layout_height="100sp"
                    android:background="@drawable/rounded_gray_border"
                    android:layout_gravity="center_horizontal"
                    android:elevation="1dp"

                    >

                    <ImageView
                        android:id="@+id/medicine_icon"
                        android:layout_width="90sp"
                        android:layout_height="90sp"
                        android:layout_gravity="center"
                        android:src="@drawable/spray"
                        android:contentDescription="картинка спрей"
                        />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_extrabold"
                    android:textSize="24sp"
                    android:layout_marginStart="10sp"
                    android:lineSpacingMultiplier="0.6"
                    android:lines="4"
                    android:ellipsize="end"
                    android:text="Аскорбинка витаминка полезная с витаминами  А и С"
                    />
            </LinearLayout>
        </FrameLayout>

        <TextView

            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:text="Б"
            android:textColor="@color/purple_500"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginEnd="10sp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_gray_border"
            android:padding="10sp"
            android:layout_marginBottom="14sp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <FrameLayout
                    android:layout_width="100sp"
                    android:layout_height="100sp"
                    android:background="@drawable/rounded_gray_border"
                    android:layout_gravity="center_horizontal"
                    android:elevation="1dp"

                    >

                    <ImageView
                        android:layout_width="90sp"
                        android:layout_height="90sp"
                        android:layout_gravity="center"
                        android:src="@drawable/spray"
                        android:contentDescription="картинка спрей"
                        />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_extrabold"
                    android:textSize="24sp"
                    android:layout_marginStart="10sp"
                    android:lineSpacingMultiplier="0.6"
                    android:lines="4"
                    android:ellipsize="end"
                    android:text="Бакторицидный пластырь"
                    />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_medications"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"/>

</LinearLayout>