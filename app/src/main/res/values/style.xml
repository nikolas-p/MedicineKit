<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="ToolBarImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">40sp</item>
        <item name="android:layout_height">40sp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:tint">@color/purple_500</item>
    </style>

    <style name="ToolBarImageButtonRed" parent="@style/ToolBarImageButton">
              <item name="android:tint">#C2185B</item>
    </style>

    <style name="ToolBarImageButtonGray" parent="@style/ToolBarImageButton">
        <item name="android:tint">#787878</item>
    </style>



    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@android:color/transparent</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
    </style>

    <!-- Базовый стиль для кнопок -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40sp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/purple_500</item>
        <item name="cornerRadius">20sp</item>
    </style>

    <!-- Стиль для основной кнопки -->
    <style name="PrimaryButton" parent="AppButton">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Стиль для второстепенной кнопки -->
    <style name="SecondaryButton" parent="AppButton">
        <item name="backgroundTint">@color/teal_700</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Стиль для outline кнопки -->
    <style name="OutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/purple_500</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/purple_500</item>
        <item name="cornerRadius">40sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">6sp</item>
        <item name="android:paddingEnd">20sp</item>
        <item name="android:paddingStart">20sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="radioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/purple_500</item>
        <item name="android:gravity">start</item>
        <item name="android:lineSpacingMultiplier">0.6</item>
        <item name="android:textSize">24sp</item>
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:layout_marginBottom">10sp</item>
        <item name="android:background">@drawable/radio_background</item>
    </style>


    <style name="CustomEditTextStyle">

        <item name="android:singleLine">true</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/edit_text_background</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/edit_text_text_color</item>
    </style>



</resources>